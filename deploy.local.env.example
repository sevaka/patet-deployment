# Copy to deploy.local.env (gitignored) and fill in your VPS details.

PATET_SSH_HOST=your.vps.hostname.or.ip
PATET_SSH_USER=deploy

# Server paths (defaults match production layout)
PATET_API_ROOT=/var/www/patet-api
PATET_WEB_ROOT=/var/www/patet-website
PATET_DEPLOYMENT_ROOT=/var/www/patet-deployment

# Local repo roots (relative to Back_and_Front or absolute)
PATET_LOCAL_BACKEND=patet-back-nestjs
PATET_LOCAL_FRONTEND=patet-website

# Optional: extra SSH args (e.g. -i C:\Users\you\.ssh\id_ed25519)
# PATET_SSH_EXTRA_ARGS=-i C:\Users\you\.ssh\id_ed25519

# Backend migrations on artifact deploy (1 = run, 0 = skip; default skip — prefer -Migrate on deploy-from-windows.ps1)
PATET_WITH_BACKEND_MIGRATE=0

# Backend .env on server (patet-api/.env) — WB scheduled import (see patet-back-nestjs/.env.example):
WB_ORDER_IMPORT_ENABLED=true
WB_ORDER_IMPORT_INTERVAL_MINUTES=10
WB_SCHEDULER_ACTOR_USER_ID=606ddff7-f343-46ca-9c0a-eaef1f6f1f38
WB_IMPORT_ALERT_EMAIL=s.arakelyan@patet.am
