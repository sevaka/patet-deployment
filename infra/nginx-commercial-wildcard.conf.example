# nginx wildcard vhost template — Server 2 commercial (NOT used on patet.am).
# Install on the commercial VPS; replace PLATFORM_DOMAIN and TLS cert paths.

# Optional: force www → apex (app middleware also redirects www).
# server {
#     listen 443 ssl http2;
#     server_name www.PLATFORM_DOMAIN;
#     ssl_certificate     /etc/letsencrypt/live/PLATFORM_DOMAIN/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/PLATFORM_DOMAIN/privkey.pem;
#     return 301 https://PLATFORM_DOMAIN$request_uri;
# }

# Tenant subdomains + apex + admin → Next.js (*.PLATFORM_DOMAIN includes www)
server {
    listen 443 ssl http2;
    server_name PLATFORM_DOMAIN *.PLATFORM_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/PLATFORM_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PLATFORM_DOMAIN/privkey.pem;
    client_max_body_size 50m;

    # LogiOps cohosted app (separate PM2 apps + DB). Managed from logiops/deployment.
    # Public: https://PLATFORM_DOMAIN/logi-ops  — install/update via:
    #   bash /var/www/logiops-deployment/scripts/install-logiops-nginx-on-commercial.sh
    # Do not force trailing-slash redirects here (conflicts with Next basePath).
    location /logi-ops/api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 30m;
    }
    location /logi-ops {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:4993;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Same-origin API per tenant subdomain (recommended)
    # Note: Socket.IO uses the dedicated /socket.io/ location below (Upgrade headers).
    # Uncomment Upgrade/Connection here only if you intentionally proxy websockets under /api/.
    location /api/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_http_version 1.1;
        # proxy_set_header Upgrade $http_upgrade;
        # proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Live slideshow Socket.IO (namespace /slideshow, websocket transport) — needs the Upgrade headers.
    location /socket.io/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
    }

    location /fulfillment-product-images/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_set_header Host $host;
    }

    location /marketplace-product-images/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_set_header Host $host;
    }

    location /marketplace-shop-images/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_set_header Host $host;
    }
}

server {
    listen 80;
    server_name PLATFORM_DOMAIN *.PLATFORM_DOMAIN;
    return 301 https://$host$request_uri;
}
