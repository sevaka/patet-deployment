# nginx wildcard vhost template — Server 2 commercial (NOT used on patet.am).
# Install on the commercial VPS; replace PLATFORM_DOMAIN and TLS cert paths.

# Tenant subdomains + apex + admin → Next.js
server {
    listen 443 ssl http2;
    server_name PLATFORM_DOMAIN *.PLATFORM_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/PLATFORM_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PLATFORM_DOMAIN/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:4993;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Same-origin API per tenant subdomain (recommended)
    location /api/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /fulfillment-product-images/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_set_header Host $host;
    }

    location /marketplace-product-images/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_set_header Host $host;
    }

    location /marketplace-shop-images/ {
        proxy_pass http://127.0.0.1:57303;
        proxy_set_header Host $host;
    }
}

server {
    listen 80;
    server_name PLATFORM_DOMAIN *.PLATFORM_DOMAIN;
    return 301 https://$host$request_uri;
}
