# Copy to deploy.local.commercial.env (gitignored) for Server 2 commercial deploys.
# Usage: .\deploy-commercial.ps1

PATET_PROFILE_LABEL=parcel-ops.com (Server 2)

PATET_SSH_HOST=67.205.168.134
PATET_SSH_USER=root

PATET_API_ROOT=/var/www/patet-api
PATET_WEB_ROOT=/var/www/patet-website
PATET_DEPLOYMENT_ROOT=/var/www/patet-deployment

PATET_LOCAL_BACKEND=patet-back-nestjs
PATET_LOCAL_FRONTEND=patet-website

# parcel-ops.moba uses PuTTY key id_rsa_2..ppk (ECDSA). deploy-from-windows.ps1 uses plink/pscp for .ppk files.
PATET_SSH_EXTRA_ARGS=-i C:\Users\sevaka\.ssh\id_rsa_2..ppk
# Required for non-interactive plink/pscp (from parcel-ops server host key)
PATET_SSH_HOSTKEY=SHA256:xNtrrZ0HJJGRrqUe8+lNhotYGUGHZdt93KkzveRvLHU

PATET_WITH_BACKEND_MIGRATE=0

# Health checks use loopback (tenant guard skips 127.0.0.1)
BACKEND_HEALTH_URL=http://127.0.0.1:57303/api/v1/auth/me
FRONTEND_HEALTH_URL=http://127.0.0.1:4993/

# --- Frontend build (injected into patet-website/.env.production.local during deploy only) ---
FRONTEND_BUILD_NEXT_PUBLIC_COMMERCIAL_MULTI_TENANT=true
FRONTEND_BUILD_NEXT_PUBLIC_COMMERCIAL_PLATFORM_DOMAIN=parcel-ops.com
FRONTEND_BUILD_NEXT_PUBLIC_API_HOST=
FRONTEND_BUILD_NEXT_PUBLIC_INTERNAL_API_BASE=/bff
